enum ProjectStatus {
  PLANNING
  OPERATIONAL
  EXPANDING
  COMPLETED
}

model ProjectCategory {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(100)
  projects Project[]

  @@map("project_categories")
}

model Project {
  id                    String          @id @default(cuid())
  name                  String          @db.VarChar(255)
  slug                  String          @unique @db.VarChar(255)
  location              String          @db.VarChar(150)
  categoryId            Int
  category              ProjectCategory @relation(fields: [categoryId], references: [id])
  status                String          @default("Đang vận hành") @db.VarChar(50)
  description           String          @db.Text
  highlights            Json?
  thumbnailUrl          String?         @db.VarChar(255)
  galleryUrls           Json?
  annualRevenue         String?         @db.VarChar(100)
  jobsCreated           Int             @default(0)
  conservationFundShare String?         @db.VarChar(50)
  ownerOrg              String?         @db.VarChar(255)
  websiteUrl            String?         @db.VarChar(255)
  isFeatured            Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@map("projects")
}
