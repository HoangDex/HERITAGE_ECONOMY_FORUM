model Page {
  id          String    @id @default(cuid())
  slug        String    @unique @db.VarChar(150)
  name        String    @db.VarChar(150)
  props       Json?
  isPublished Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@map("pages")
}
