enum SubmissionType {
  ATTENDANCE
  SPONSORSHIP
  PARTNERSHIP
  PROJECT_PROPOSAL
  AWARD_NOMINATION
  GENERAL
}

enum SubmissionStatus {
  NEW
  IN_REVIEW
  CONTACTED
  RESOLVED
}

model ContactSubmission {
  id            String           @id @default(cuid())
  pageSlug      String?          @db.VarChar(150) // Nộp từ trang nào (slug: home, forum, awards, contact...)
  pageName      String?          @db.VarChar(150) // Tên trang nộp CTA ("Diễn đàn", "Giải thưởng", "Liên hệ")
  page          Page?            @relation(fields: [pageSlug], references: [slug], onDelete: SetNull)
  type          SubmissionType   @default(GENERAL)
  fullName      String           @db.VarChar(150)
  email         String           @db.VarChar(191)
  phone         String?          @db.VarChar(50)
  organization  String?          @db.VarChar(255)
  position      String?          @db.VarChar(150)
  message       String           @db.Text
  attachmentUrl String?          @db.VarChar(255)
  status        SubmissionStatus @default(NEW)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([pageSlug])
  @@index([type])
  @@index([status])
  @@map("contact_submissions")
}
